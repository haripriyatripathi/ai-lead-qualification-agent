# Database (async driver for FastAPI)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/leadiagent

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Ollama (local LLM). In Docker compose, use http://ollama:11434 (service name).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=60

# SMTP (optional – for sending reply emails to leads)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=example@gmail.com
SMTP_PASSWORD=apppassword
SMTP_FROM_EMAIL=example@gmail.com

# Slack (optional)
SLACK_WEBHOOK_URL=
ENABLE_SLACK=false

# Scoring: send email/Slack when score >= this
SCORE_THRESHOLD_NOTIFY=70

# Logging
LOG_LEVEL=INFO
